rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "khcnryddF0XTZSVERg1D2w7ajCn1",
          "RIeTh11rFbWv7Ns1fVJeh8s2xHy1"
        ];
    }

    // Gallery content: album categories, their albums, and the image
    // documents inside them. Readable by anyone, writable only by an admin.
    // Cloud Functions use the Admin SDK and bypass these rules.
    match /albumCategories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
